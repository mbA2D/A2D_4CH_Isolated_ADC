{
  "version": "2.0.0",
  "tasks": [
    {"label": "Build firmware", "type": "shell", "command": "powershell",
     "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/build.ps1"],
     "group": {"kind": "build", "isDefault": true}, "problemMatcher": "$gcc"},
    {"label": "Upload firmware", "type": "shell", "command": "${workspaceFolder}/.venv/Scripts/python.exe",
     "args": ["tools/usb_upload.py"], "dependsOn": "Build firmware", "problemMatcher": []}
  ]
}

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(ARM_GCC arm-none-eabi-gcc REQUIRED HINTS "$ENV{ARM_GCC_BIN}")
get_filename_component(ARM_GCC_BIN "${ARM_GCC}" DIRECTORY)
set(CMAKE_C_COMPILER "${ARM_GCC}")
get_filename_component(ARM_SUFFIX "${ARM_GCC}" LAST_EXT)
set(CMAKE_ASM_COMPILER "${ARM_GCC}")
set(CMAKE_OBJCOPY "${ARM_GCC_BIN}/arm-none-eabi-objcopy${ARM_SUFFIX}" CACHE FILEPATH "")
set(CMAKE_SIZE "${ARM_GCC_BIN}/arm-none-eabi-size${ARM_SUFFIX}" CACHE FILEPATH "")
